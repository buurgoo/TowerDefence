using System.Collections;
using Unity.Netcode;
using UnityEngine;

public class TrainingOpponentLoop : NetworkBehaviour
{
    [SerializeField]
    private MapGenerator mapGenerator;

    [SerializeField]
    private EnemyPool enemyPool;

    [SerializeField]
    private Inventory inventory;

    [SerializeField]
    private int playerId = 0;

    [SerializeField]
    private float tickInterval = 1f;

    [SerializeField]
    private TrainingStrategyType strategy = TrainingStrategyType.ImmediateAttack;

    private TrainingOpponent _opponent;

    public override void OnNetworkSpawn()
    {
        if (!IsServer) return;
        _opponent = new TrainingOpponent(mapGenerator, enemyPool, inventory, playerId, strategy);
        StartCoroutine(RunLoop());
    }

    private IEnumerator RunLoop()
    {
        while (IsServer)
        {
            _opponent.Tick();
            yield return new WaitForSeconds(tickInterval);
        }
    }
}
